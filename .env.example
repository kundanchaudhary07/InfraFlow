# ─── Application configuration ────────────────────────────────────────────────
# Copy this file to .env and adjust values for your local environment.
# Never commit a populated .env file to source control.

# Human-readable name shown in Swagger UI and logs
APP_NAME="DeployGuard Demo — Order Service"

# Semantic version of this service
APP_VERSION="0.1.0"

# Service identifier used in structured telemetry logs
SERVICE_NAME="deployguard-demo"

# Logging level (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL="INFO"

# Runtime environment label (development | staging | production)
ENVIRONMENT="development"

# Interface the Uvicorn server listens on
HOST="127.0.0.1"

# Port the Uvicorn server listens on
PORT=8000
